# SEC requires a descriptive User-Agent with a real contact email on every request.
# https://www.sec.gov/search-filings/edgar-search-assistance/accessing-edgar-data
SEC_USER_AGENT="Your Org Name you@example.com"

# Hard-capped at 10 by the client regardless of this value (SEC fair access limit).
SEC_MAX_RPS=10

DATABASE_URL=postgresql://lpmap:lpmap@localhost:5432/lpmap

# First quarter to backfill from the Form D bulk data sets.
FORMD_BACKFILL_FROM=2016q1

# --- Web app (apps/web) ---
# Sign-in is disabled until both are set. Password: at least 12 characters.
ADMIN_PASSWORD=
# Random string, at least 32 characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Public URL of the web app (used for Google OAuth redirect and email links).
APP_URL=http://localhost:3000
# 64 hex chars; encrypts integration tokens at rest. `openssl rand -hex 32`
ENCRYPTION_KEY=

# Optional: Google contacts + calendar (OAuth client of type "Web application";
# redirect URI = $APP_URL/api/google/callback; enable People API + Google Calendar API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email when a mapping run finishes (https://resend.com). In-app notifications always work.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
